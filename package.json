{
  "name": "learnhub",
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.0.0",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "admin:create": "node backend/scripts/create-admin.js",
    "start": "node scripts/start.js --tunnel",
    "app": "node scripts/start.js --lan",
    "start:expo": "node scripts/start.js --lan",
    "start:tunnel": "node scripts/start.js --tunnel",
    "dev": "node scripts/start.js --lan",
    "dev:tunnel": "node scripts/start.js --tunnel",
    "dev:local": "node scripts/start.js --lan --local-api",
    "escola": "node scripts/start.js --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --no-cache",
    "typecheck": "tsc --noEmit",
    "backend": "node backend/src/server.js",
    "server": "node backend/src/server.js",
    "diagnose": "node scripts/diagnose.js",
    "setup:firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-firewall.ps1",
    "test": "node --test backend/tests/validation.test.js backend/tests/network.test.js backend/tests/community.test.js backend/tests/api.test.js",
    "test:auth": "node backend/tests/auth.integration.js",
    "test:hosted": "node backend/tests/hosted-crud.integration.js",
    "test:hosted:community": "node backend/tests/hosted-community.integration.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "expo": "^58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
