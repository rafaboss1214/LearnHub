{
  "name": "learnhub",
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.0.0",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "start": "node scripts/start.js --tunnel",
    "app": "node scripts/start.js --lan",
    "start:expo": "node scripts/start.js --lan",
    "start:tunnel": "node scripts/start.js --tunnel",
    "dev": "node scripts/start.js --lan",
    "dev:tunnel": "node scripts/start.js --tunnel",
    "dev:local": "node scripts/start.js --lan --local-api",
    "escola": "node scripts/start.js --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --no-cache",
    "typecheck": "tsc --noEmit",
    "backend": "node backend/src/server.js",
    "server": "node backend/src/server.js",
    "diagnose": "node scripts/diagnose.js",
    "setup:firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-firewall.ps1",
    "test": "node --test backend/tests/validation.test.js backend/tests/network.test.js backend/tests/api.test.js",
    "test:auth": "node backend/tests/auth.integration.js",
    "test:hosted": "node backend/tests/hosted-crud.integration.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
